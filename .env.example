# Supabase (Browser / Vite)
# Kopiere diese Datei nach .env und trage deine Werte ein:
#   cp .env.example .env
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Vercel AI Gateway — nur serverseitig, kein VITE_-Prefix (sonst landet der Key im Browser).
# Lokal: Key im Vercel-Dashboard unter AI Gateway erzeugen.
# Auf Vercel reicht oft OIDC; der Key ist Fallback für lokale Entwicklung.
AI_GATEWAY_API_KEY=
