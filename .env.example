# Supabase (Browser / Vite)
# Kopiere diese Datei nach .env und trage deine Werte ein:
#   cp .env.example .env
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only — kein VITE_-Prefix. Wird gebraucht, um User-Keys verschlüsselt zu speichern.
# Secret Key im Supabase Dashboard unter Settings > API.
# Dieselben Variablen auch in Vercel (Production/Preview) setzen.
SUPABASE_SECRET_KEY=
# 32-Byte-Key als Base64, z. B.: openssl rand -base64 32
USER_SECRETS_ENCRYPTION_KEY=

# Strava (nur Server — kein VITE_-Prefix). Zwei Apps empfohlen (localhost vs. Production),
# weil Strava nur eine Authorization Callback Domain pro App erlaubt.
# Redirect: http://localhost:5173/strava/callback bzw. https://<domain>/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
# Optional, Production-Webhook: gleiche Zeichenkette wie beim Anlegen der Push-Subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Optional: Subscription-ID, damit fremde POSTs ignoriert werden.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Foto-Analyse (nur Server — kein VITE_-Prefix)
# Lokal: Google-AI-Studio-Key (GEMINI_API_KEY) und/oder Vercel AI Gateway.
# Gateway: AI_GATEWAY_API_KEY setzen ODER FOOD_PHOTO_USE_AI_GATEWAY=true (explizites OIDC).
# process.env.VERCEL allein gilt nicht als Gateway-Auth.
# Ein im Profil hinterlegter User-Key hat Vorrang vor dem App-Key.
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
FOOD_PHOTO_USE_AI_GATEWAY=

# App-Key (GEMINI_API_KEY / Gateway) nur für diese Accounts — 5 Analysen / 24h, sonst eigenen Key im Profil.
# Komma-getrennte UUIDs bzw. E-Mails (Trim, E-Mail case-insensitive).
# Leere Listen = niemand bekommt den App-Key (fail-closed).
FOOD_PHOTO_APP_KEY_USER_IDS=
FOOD_PHOTO_APP_KEY_EMAILS=
