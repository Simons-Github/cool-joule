# Supabase (Browser / Vite)
# Kopiere diese Datei nach .env und trage deine Werte ein:
#   cp .env.example .env
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only — kein VITE_-Prefix. Wird gebraucht, um User-Keys verschlüsselt zu speichern.
# Secret Key im Supabase Dashboard unter Settings > API.
# Dieselben Variablen auch in Vercel (Production/Preview) setzen.
SUPABASE_SECRET_KEY=
# 32-Byte-Key als Base64, z. B.: openssl rand -base64 32
USER_SECRETS_ENCRYPTION_KEY=

# Foto-Analyse (nur Server — kein VITE_-Prefix)
# Lokal: Google-AI-Studio-Key (GEMINI_API_KEY) ODER Vercel AI Gateway.
# Auf Vercel reicht oft OIDC; AI_GATEWAY_API_KEY ist Fallback.
# Ein im Profil hinterlegter User-Key hat Vorrang vor GEMINI_API_KEY.
# Ohne User-Key gilt 1 Fotoanalyse / 24 h auf den App-Key.
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
